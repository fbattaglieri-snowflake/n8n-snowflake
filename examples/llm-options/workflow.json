    {
      "parameters": {
        "color": 5,
        "content": "## Option D — Cortex Agent via SPCS SQL API\nCalls `SNOWFLAKE.CORTEX.DATA_AGENT_RUN` via `CORTEX_PROXY_DNS_NAME:8080/api/v2/statements` (rotating SPCS OAuth token, least-privilege `N8N_DEMO_ROLE`) and extracts the clean final answer.",
        "height": 240,
        "width": 352
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [
        -560,
        -352
      ],
      "typeVersion": 1,
      "id": "note-opt-d",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.data;\n\n// Path 1: Snowflake SQL API /api/v2/statements -> data: [[ \"<DATA_AGENT_RUN JSON>\" ]]\nif (Array.isArray(raw)) {\n  const cell = raw[0]?.[0] ?? '';\n  try {\n    const parsed = typeof cell === 'string' ? JSON.parse(cell) : cell;\n    const texts = (parsed?.content || [])\n      .filter(b => b && b.type === 'text' && b.text)\n      .map(b => b.text);\n    return [{ json: { response: texts.join('\\n\\n').trim() } }];\n  } catch {\n    return [{ json: { response: String(cell) } }];\n  }\n}\n\n// Path 2: Direct Cortex Agent REST SSE stream\nconst sseText = String(raw ?? '');\nconst answer = [];\nfor (const block of sseText.replace(/\\r\\n/g, '\\n').split(/\\n\\n+/)) {\n  let eventType = '';\n  let eventData = '';\n  for (const line of block.split('\\n')) {\n    if (line.startsWith('event: ')) eventType = line.slice(7).trim();\n    if (line.startsWith('data: '))  eventData = line.slice(6).trim();\n  }\n  if (eventType !== 'response.text.delta') continue;\n  try {\n    const parsed = JSON.parse(eventData);\n    if (parsed.text) answer.push(parsed.text);\n  } catch { continue; }\n}\nreturn [{ json: { response: answer.join('').trim() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        -144
      ],
      "id": "clean-agent-response",
      "name": "Clean Cortex Agent Response"
    },
